{
  "name": "petween-desktop",
  "version": "0.3.10",
  "description": "Petween desktop pet — Electron shell + DSH state bridge around the petween plugin (zero-modification assembly)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:petween": "pnpm --dir vendor/petween run build",
    "dist:win": "pnpm build:petween && electron-vite build && electron-builder --win",
    "typecheck": "tsc --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7",
    "fflate": "^0.8.3",
    "petween": "link:./vendor/petween",
    "petween-physics": "link:./vendor/petween-physics",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
